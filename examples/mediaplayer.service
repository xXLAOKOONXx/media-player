[Unit]
Description=Media Player Backend Service
After=network.target multi-user.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/media-player/backend

# Environment variables
Environment="SDL_AUDIODRIVER=alsa"
Environment="DISPLAY=:0"
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# Main service command (use the project's venv created by `uv venv`)
ExecStart=/home/pi/media-player/backend/.venv/bin/python /home/pi/media-player/backend/app.py

# Restart configuration
Restart=always
RestartSec=10

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mediaplayer

# Security settings (optional, adjust as needed)
# NoNewPrivileges=true
# PrivateTmp=true

# Resource limits (optional)
# Nice=-5
# IOSchedulingClass=realtime
# IOSchedulingPriority=0

[Install]
WantedBy=multi-user.target
